mdp

module main
    state: [1..5] init 1;

    [] (state=1) -> (state'=2);
    [] (state=1) -> (state'=3);
    [] (state=2) -> (state'=4);
    [] (state=2) -> (state'=5);
    [] (state=3) -> (state'=4);
    [] (state=3) -> (state'=5);
    [] (state=4) -> (state'=4);
    [] (state=5) -> (state'=5);

endmodule

label "good" = (state = 4);
label "bad" = (state = 5);
